{
  "name": "personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix notion-site run dev",
    "build": "npm --prefix notion-site run build && node -e \"const fs = require('fs'); fs.cpSync('notion-site/dist', 'dist', {recursive: true});\"",
    "preview": "npm --prefix notion-site run preview",
    "build:portfolio": "vite build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
}
